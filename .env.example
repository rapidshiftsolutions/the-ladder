# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_TOKEN=

# GiveButter (required for live donations — only donation method)
# Settings → Integrations → Widgets (Account ID)
NEXT_PUBLIC_GIVEBUTTER_ACCOUNT_ID=
# Campaign short code near campaign title (or use Widget ID below)
NEXT_PUBLIC_GIVEBUTTER_CAMPAIGN_CODE=
# Optional: dashboard-generated widget id from Sharing → Widgets → Embed
NEXT_PUBLIC_GIVEBUTTER_WIDGET_ID=

# Optional site / third-party
NEXT_PUBLIC_SITE_URL=https://the-ladder.org
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_VERIFICATION=
